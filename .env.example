# Create a separate Supabase project just for Hamemo.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-HAMEMO-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=hamemo-media
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Never put the service-role key in NEXT_PUBLIC variables or in the browser.
SUPABASE_SERVICE_ROLE_KEY=
